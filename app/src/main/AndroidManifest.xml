<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        android:name=".App" tells Android to use our custom Application class.
        This is what makes App.kt run on startup and register the
        ActivityLifecycleCallbacks that handle automatic logout.
        WITHOUT this line, App.kt is never instantiated and the fix won't work.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulserds_PROG7313">
        <activity
            android:name=".ui.AddTransactionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ManageCategoriesActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.AnalyticsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AddSubscriptionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ManageSubscriptionsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CreateSavingsGoalActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SavingsGoalsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.TransactionsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AddAccountActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AccountsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DashBoardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CreateAccActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>