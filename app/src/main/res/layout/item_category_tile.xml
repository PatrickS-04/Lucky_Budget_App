<?xml version="1.0" encoding="utf-8"?>
<!--
    item_category_tile.xml
    Inflated by CategoryTileAdapter for each user category in the Budget Categories grid.
    The host RecyclerView uses GridLayoutManager(context, 2) so each tile occupies one column.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_margin="5dp"
    app:cardBackgroundColor="#1A3A2A"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Category emoji icon — derived from category name in the adapter -->
        <TextView
            android:id="@+id/tileIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁"
            android:textSize="20sp" />

        <!-- Category name from DB -->
        <TextView
            android:id="@+id/tileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Category"
            android:textColor="#FFFFFFD9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Placeholder spend amount — wire to ExpenseEntry totals once available -->
        <TextView
            android:id="@+id/tileAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amount_zero_short"
            android:textColor="#6ADB8A"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>