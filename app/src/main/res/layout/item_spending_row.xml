<?xml version="1.0" encoding="utf-8"?>
<!--
    item_spending_row.xml
    Inflated by SpendingRowAdapter for each category in the Spending Breakdown list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13dp"
    android:orientation="vertical">

    <!-- Top row: icon · name · amount · percentage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="📁"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/rowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Category"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amount_zero_short"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0%"
            android:textColor="#7A6A50"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Progress bar — progress set programmatically from percentage -->
    <ProgressBar
        android:id="@+id/rowProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#33000000"
        android:progressTint="#1A3A2A" />

</LinearLayout>