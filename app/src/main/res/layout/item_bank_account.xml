<?xml version="1.0" encoding="utf-8"?>
<!--
    item_bank_account.xml
    Inflated inside AccountsActivity.renderAccountsList() for each BankAccount row.
    Place in: app/src/main/res/layout/item_bank_account.xml
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Colour dot -->
    <View
        android:id="@+id/accountDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="#4ADE80"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Left column: bank name + account type -->
    <LinearLayout
        android:id="@+id/accountInfoCol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/accountDot"
        app:layout_constraintEnd_toStartOf="@id/accountAmountCol"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/accountBankName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bank Name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountTypeTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cheque"
            android:textColor="#4ADE80"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Right column: balance + masked number -->
    <LinearLayout
        android:id="@+id/accountAmountCol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/accountBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R 0.00"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/accountMasked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="**** 0000"
            android:textColor="#7A99B0"
            android:textSize="12sp"
            android:gravity="end" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>