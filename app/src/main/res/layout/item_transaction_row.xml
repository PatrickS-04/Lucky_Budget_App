<!--
    item_transaction_row.xml
    One transaction row in the Transactions list.
 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingTop="14dp" android:paddingEnd="20dp" android:paddingBottom="14dp">
    <!--  Category emoji icon  -->
    <androidx.cardview.widget.CardView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="14dp" app:cardBackgroundColor="#0D2A1A" app:cardCornerRadius="12dp" app:cardElevation="0dp">
        <TextView android:id="@+id/txIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📁" android:textSize="20sp"/>
    </androidx.cardview.widget.CardView>
    <!--  Description + subtitle  -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Transaction" android:textColor="@color/very_darkGreen" android:textSize="14sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category • Account" android:textColor="#7A99B0" android:textSize="12sp"/>
            <!--  Receipt badge — shown only when photoPath is not null  -->
            <androidx.cardview.widget.CardView android:id="@+id/txReceiptBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:clickable="true" android:focusable="true" android:visibility="gone" app:cardBackgroundColor="#0D2A1A" app:cardCornerRadius="6dp" app:cardElevation="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingTop="2dp" android:paddingEnd="6dp" android:paddingBottom="2dp" android:text="📄 Receipt" android:textColor="#4ADE80" android:textSize="10sp" android:textStyle="bold"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
    <!--  Amount + date  -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
        <TextView android:id="@+id/txAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:text="@string/amount_default" android:textColor="#F87171" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="end" android:text="--" android:textColor="#3D5A70" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>