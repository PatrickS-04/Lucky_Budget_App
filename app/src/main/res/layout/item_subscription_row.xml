<?xml version="1.0" encoding="utf-8"?>
<!-- Single subscription row used by SubscriptionAdapter -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <!-- Icon card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/subIconCard"
        android:layout_width="46dp"
        android:layout_height="46dp"
        app:cardBackgroundColor="#0D1B2A"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/subIconText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📋"
            android:textSize="20sp" />
    </androidx.cardview.widget.CardView>

    <!-- Name + detail + renewal badge (left-centre column) -->
    <LinearLayout
        android:id="@+id/subInfoCol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/subRightCol"
        app:layout_constraintStart_toEndOf="@id/subIconCard"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/subNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Category  •  Account"
            android:textColor="#7A7A7A"
            android:textSize="12sp" />

        <!-- Renewal / paused badge -->
        <androidx.cardview.widget.CardView
            android:id="@+id/subRenewalBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:cardBackgroundColor="#2A1000"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/subRenewalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="  Renews  "
                android:textColor="#FFA040"
                android:textSize="10sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Amount + auto-pay (right column) -->
    <LinearLayout
        android:id="@+id/subRightCol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/subAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="R 0.00/mo"
            android:textColor="#F87171"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subAutoPayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:text="Auto-pay ON"
            android:textColor="#4ADE80"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>